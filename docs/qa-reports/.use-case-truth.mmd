%% Total: 27 use cases, 5 actors (Customer, LoyalCustomer, Admin, Kasir, Driver)
%% Note: Mermaid tidak punya native usecase syntax, jadi pakai flowchart LR
%%       dengan subgraph per domain + edge labels untuk include/extend.

flowchart LR
    %% ================== ACTORS ==================
    Customer((👤 Customer))
    LoyalCustomer((⭐ Loyal<br/>Customer))
    Admin((🛡️ Admin))
    Kasir((💵 Kasir))
    Driver((🚗 Driver))

    %% Inheritance: LoyalCustomer adalah specialized Customer
    LoyalCustomer -.->|"«extends»<br/>(generalization)"| Customer

    %% ================== SYSTEM BOUNDARY ==================
    subgraph SYS["🏢 Rent Car Platform (Web)"]

        %% ---------- AUTH ----------
        subgraph AUTH["🔐 Authentication"]
            UC01["UC-01<br/>Registrasi / Login"]
            UC26["UC-26<br/>Pilih Role Dashboard<br/>(role-based redirect)"]
        end

        %% ---------- CATALOG & BOOKING ----------
        subgraph BOOK["📋 Catalog & Booking"]
            UC02["UC-02<br/>Browse Katalog<br/>& Lihat Detail"]
            UC03["UC-03<br/>Buat Order Sewa<br/>Kendaraan"]
            UC04["UC-04<br/>Pilih Durasi, Unit,<br/>Wilayah, Lokasi"]
            UC05["UC-05<br/>Hitung Tarif<br/>Otomatis"]
            UC06["UC-06<br/>Pilih Supir"]
            UC07["UC-07<br/>Free Upgrade<br/>(manual accept/reject)"]
            UC08["UC-08<br/>Pesan Layanan<br/>Antar-Jemput"]
        end

        %% ---------- PAYMENT ----------
        subgraph PAY["💳 Payment"]
            UC09["UC-09<br/>Upload Bukti<br/>Transfer"]
            UC10["UC-10<br/>Input Pembayaran<br/>Tunai"]
            UC11["UC-11<br/>Verifikasi<br/>Transfer"]
            UC12["UC-12<br/>Generate Kwitansi<br/>(digital)"]
            UC27["UC-27<br/>Refund Payment<br/>(admin only) 🆕"]
        end

        %% ---------- MASTER DATA ----------
        subgraph MASTER["⚙️ Master Data"]
            UC13["UC-13<br/>Kelola Kendaraan<br/>& Kategori"]
            UC14["UC-14<br/>Kelola Pricing Rule<br/>& Overtime Penalty"]
            UC15["UC-15<br/>Kelola Data<br/>Supir"]
            UC19["UC-19<br/>Kelola Tarif<br/>Shuttle"]
        end

        %% ---------- ORDER LIFECYCLE ----------
        subgraph LIFE["🔁 Order Lifecycle"]
            UC16["UC-16<br/>Dispatch Order<br/>(payment-locked)"]
            UC17["UC-17<br/>Catat Return<br/>& Aktual Time"]
            UC18["UC-18<br/>Hitung Overtime<br/>(kelipatan jam)"]
            UC20["UC-20<br/>Complete Order"]
        end

        %% ---------- DASHBOARD & REPORT ----------
        subgraph REPORT["📊 Dashboard & Report"]
            UC21["UC-21<br/>Lihat Dashboard<br/>Operasional"]
            UC22["UC-22<br/>Generate Laporan<br/>Transaksi & Revenue"]
        end

        %% ---------- AUDIT & RECEIPTS & HISTORY ----------
        subgraph SHARED["📚 Shared / History"]
            UC23["UC-23<br/>View Audit Log<br/>(internal)"]
            UC24["UC-24<br/>Lihat Receipt<br/>(customer + staff)"]
            UC25["UC-25<br/>Lihat Riwayat<br/>Order"]
        end
    end

